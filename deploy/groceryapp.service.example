# Copy to /etc/systemd/system/groceryapp.service and replace YOUR_USER.
[Unit]
Description=GroceryApp home-network web interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/apps/GroceryApp
Environment=PYTHONUNBUFFERED=1
Environment=PORT=8081
ExecStart=/home/YOUR_USER/apps/GroceryApp/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8081 --access-logfile - --error-logfile - web_app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
